# SQLite local: deja DATABASE_URL vacío.
DATABASE_URL=
SQLITE_PATH=./data/store.sqlite
UPLOAD_DIR=./uploads
PORT=3002
NODE_ENV=development
# En Azure detrás de un único proxy de confianza: TRUST_PROXY=1
TRUST_PROXY=0
# PostgreSQL: DATABASE_URL=postgresql://usuario:clave@servidor:5432/belleza_conceptual
# Azure PostgreSQL con TLS y validación del certificado:
DB_SSL=false
# Solo para npm run admin:create; elimina la contraseña después de crear la cuenta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
